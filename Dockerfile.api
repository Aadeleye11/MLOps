FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    TF_NUM_INTRAOP_THREADS=2 \
    TF_NUM_INTEROP_THREADS=2

WORKDIR /app
COPY requirements/api.txt /tmp/requirements-api.txt
RUN python -m pip install --no-cache-dir --only-binary=:all: -r /tmp/requirements-api.txt

RUN groupadd --gid 10001 leafvision \
    && useradd --uid 10001 --gid leafvision --create-home leafvision \
    && install -d -o leafvision -g leafvision /app/artifacts
COPY src/ src/
COPY scripts/audit_image_hashes.py scripts/prepare_splits.py scripts/
COPY models/crop_model_v1.h5 models/

USER leafvision
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).close()"]
CMD ["python", "-m", "uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
