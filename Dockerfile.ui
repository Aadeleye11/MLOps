FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app
COPY requirements/ui.txt /tmp/requirements-ui.txt
RUN python -m pip install --no-cache-dir --only-binary=:all: -r /tmp/requirements-ui.txt

RUN groupadd --gid 10001 leafvision \
    && useradd --uid 10001 --gid leafvision --create-home leafvision
COPY frontend/ frontend/
COPY src/__init__.py src/schemas.py src/
COPY .streamlit/config.toml .streamlit/config.toml

USER leafvision
EXPOSE 8501
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=4).close()"]
CMD ["python", "-m", "streamlit", "run", "frontend/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
